      },
      "providers": {
        "ollama": {"status": "available", "capabilities": ["chat"]}
      },
      "expected": {"status": "unavailable", "selected_task_id": null, "selected_provider": null, "fallback_used": false}
    },
    {
      "name": "unavailable_without_fallback",
      "task_id": "assistant_chat",
      "default_model": "default-model",
      "default_provider_id": "ollama",
      "profiles": {
        "assistant_chat": {"provider": "ollama", "model": "chat-model"}
      },
      "providers": {
        "ollama": {"status": "unavailable", "capabilities": ["chat"]}
      },
      "expected": {"status": "unavailable", "selected_task_id": null, "selected_provider": null, "fallback_used": false}
    }
  ]
